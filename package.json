{
  "name": "gamets",
  "version": "0.1.5",
  "description": "GameTS: una librería 2D para TypeScript y la web. Proporciona herramientas, no una forma de hacer juegos.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "game",
    "gamedev",
    "2d",
    "canvas",
    "typescript",
    "pygame",
    "web",
    "html5"
  ],
  "license": "MIT",
  "author": "",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "gamets": "file:"
  }
}
